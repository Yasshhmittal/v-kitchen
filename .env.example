# ---------------------------------------------------------------------------
# Database — matches docker-compose.yml (host port 5433 to avoid clashing with
# any local Postgres already on 5432).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://vkitchen:vkitchen_dev_password@localhost:5433/vkitchen?schema=public"

# ---------------------------------------------------------------------------
# Auth — GENERATE YOUR OWN before deploying:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-in-production-000000"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-in-production-00000"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# Customers sign in with a code sent to their phone, not a password, so their
# session is deliberately long — the alternative is an SMS every time someone
# wants to reorder lunch. Still revocable: tokens are hashed rows, rotated on
# use, and a blocked customer stops working immediately regardless of this.
CUSTOMER_REFRESH_TOKEN_TTL_DAYS="180"

# ---------------------------------------------------------------------------
# Seed owner account — created by `npm run db:seed`. CHANGE THE PASSWORD AFTER
# YOUR FIRST LOGIN.
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL="owner@vkitchen.local"
SEED_OWNER_PASSWORD="ChangeMe@123"
SEED_OWNER_NAME="V-Kitchen Owner"

# ---------------------------------------------------------------------------
# Image storage. STORAGE_PROVIDER=local writes to ./public/uploads.
# Set STORAGE_PROVIDER=cloudinary and fill the three CLOUDINARY_* values to
# switch — no code changes required.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="local"
MAX_UPLOAD_MB="5"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Messaging — sign-in codes and order receipts.
#
# Leave both providers unset and the app uses its console senders: the SMS code
# and the full receipt are printed to the terminal, so the whole flow is
# testable before buying anything. Credentials belong HERE and never in the
# site_settings table — that table is plaintext JSON, readable by any staff
# member with settings access, and is copied into admin audit logs.
# ---------------------------------------------------------------------------
# SMS_PROVIDER=twilio | msg91   (unset = print to console)
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# MSG91 sends via a DLT-approved template — the wording lives on their
# dashboard, and MSG91_TEMPLATE_ID points at it.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# MAIL_PROVIDER=resend   (unset = print to console)
MAIL_PROVIDER=""
RESEND_API_KEY=""
MAIL_FROM="V-Kitchen <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used for canonical URLs, share previews and the "track your order" link in
# receipt emails — an email has no request to infer the host from.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Optional — Redis caching (phase 2)
REDIS_URL="redis://localhost:6380"
